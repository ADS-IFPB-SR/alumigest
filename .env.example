# ==========================================
# AlumiGest - Variáveis de Ambiente de Exemplo
# ==========================================

# Banco de Dados PostgreSQL
POSTGRES_DB=alumigest_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Interface Web PgAdmin 4
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@alumigest.com
PGADMIN_DEFAULT_PASSWORD=admin

# Backend Spring Boot
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend React / Vite
FRONTEND_PORT=3000

# Dados da Empresa Emissora (PDF Comercial)
EMPRESA_RAZAO_SOCIAL=Alumiportas LTDA
EMPRESA_CNPJ=00.000.000/0000-00
EMPRESA_IE=Isento
EMPRESA_TELEFONE=(83) 99999-9999
EMPRESA_ENDERECO=Rua Principal, 100 - Centro
EMPRESA_CIDADE_UF=Sousa - PB

