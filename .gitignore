# ==========================================
# AlumiGest Monorepo - .gitignore
# ==========================================

# Ambientes e Sistemas Operacionais
.DS_Store
Thumbs.db
*.tmp
*.log
*.bak

# IDEs e Editores
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Backend - Java / Maven / Gradle / Spring Boot
backend/target/
backend/build/
backend/.gradle/
backend/*.jar
backend/*.war
backend/*.class
backend/logs/
backend/.env
!.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.jar

# Frontend - Node / TypeScript / React / Vite / PWA
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.npm
frontend/.eslintcache
frontend/*.tsbuildinfo
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Banco de Dados e Containers
postgres-data/
*.sqlite
*.db
docker-compose.override.yml

# Planejamento
.planning


# Configurações Locais
.env
